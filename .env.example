# Optional. Without a key the app runs in demo mode: mapping suggestions come
# from deterministic heuristics and nothing is sent to an LLM.
OPENROUTER_API_KEY=

# Any OpenRouter model that supports structured output (JSON schema / tool calling).
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Reasoning effort for models that think before answering: off | minimal | low | medium | high.
# Column mapping needs little; "low" keeps reasoning models within the request time budget.
OPENROUTER_REASONING_EFFORT=low
